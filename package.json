{
  "name": "shift-creat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file=.env.local scripts/dev-api-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-build": "prisma generate && prisma migrate deploy && vite build",
    "db:generate": "prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^5.20.0",
    "vite": "^5.4.6"
  }
}
